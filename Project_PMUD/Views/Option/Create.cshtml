@model Project_PMUD.Models.Option

@{
    ViewData["Title"] = "Thêm đáp án mới";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Thêm đáp án mới</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Nội dung đáp án</label>
                            <input asp-for="Optiontext" class="form-control" placeholder="Nhập nội dung đáp án..." />
                            <span asp-validation-for="Optiontext" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Chọn câu hỏi thuộc về</label>
                            <select asp-for="Questionid" class="form-select" asp-items="@(ViewData["Questionid"] as SelectList)">
                                <option value="">-- Chọn câu hỏi --</option>
                            </select>
                            <span asp-validation-for="Questionid" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="Iscorrect" id="isCorrectCheck" />
                            <label class="form-check-label fw-bold" for="isCorrectCheck">
                                Đánh dấu là đáp án đúng
                            </label>
                            <span asp-validation-for="Iscorrect" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Lưu đáp án</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}