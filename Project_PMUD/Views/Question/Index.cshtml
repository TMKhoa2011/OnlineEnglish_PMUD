@model IEnumerable<Project_PMUD.Models.Question>

@{
    ViewData["Title"] = "Quản lý Câu hỏi";
}

<div class="container mt-4">
    <h2 class="mb-4">Ngân hàng Câu hỏi</h2>

    <p>
        <a asp-action="Create" class="btn btn-success">
            + Thêm câu hỏi mới
        </a>
    </p>

    <!-- Form Tìm kiếm & Lọc theo Chủ đề -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm kiếm nội dung câu hỏi..." />
            </div>
            <div class="col-md-4">
                <select name="topicId" asp-items="@(ViewData["TopicId"] as SelectList)" class="form-select">
                    <option value="">-- Tất cả chủ đề --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Lọc / Tìm</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa lọc</a>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 40%;">Nội dung câu hỏi</th>
                    <th>Chủ đề</th>
                    <th>Mức độ</th>
                    <th>Ngày tạo</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@Html.DisplayFor(modelItem => item.Content)</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @(item.Topic != null ? item.Topic.Name : "Chưa phân loại")
                                </span>
                            </td>
                            <td>
                                @if (item.Difficulty == 1)
                                {
                                    <span class="badge bg-success">Dễ</span>
                                }
                                else if (item.Difficulty == 2)
                                {
                                    <span class="badge bg-warning text-dark">Trung bình</span>
                                }
                                else if (item.Difficulty == 3)
                                {
                                    <span class="badge bg-danger">Khó</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa xác định</span>
                                }
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Createdat)</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Chi tiết</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có câu hỏi nào trong hệ thống.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>